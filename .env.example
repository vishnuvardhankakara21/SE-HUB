# MongoDB Connection (Required for persistent multi-user database & seeding)
# If omitted or offline, the platform gracefully uses built-in authoritative data stores!
MONGODB_URI=mongodb://localhost:27017/se-learning-platform
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/se-learning-platform?retryWrites=true&w=majority

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=se_learning_platform_super_secret_key_change_in_production_2026

# Google OAuth (Optional - for Google Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (Optional - for Faculty Document & PDF Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SEO & Search Engine Verification (Optional)
NEXT_PUBLIC_SITE_URL=https://se-hub-anits.vercel.app
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

